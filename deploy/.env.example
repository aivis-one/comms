# =============================================================================
# COMMS deploy -- environment REFERENCE (.env.example)
# =============================================================================
#
# The real ./.env is GENERATED by `comms-deploy.sh install` next to
# docker-compose.yml and is never committed. This file documents every
# variable a deploy can set: what it does, who writes it, and what a
# sane value looks like. tests/test_env_template.py holds it to the
# code both ways -- every setting of app/core/config.py is here, every
# variable here is read by comms, its compose file or its installer.
#
# WHO WRITES IT -- the `# by:` line right above each variable:
#   install              `comms-deploy.sh install` writes it into the
#                        generated .env (generate_env);
#   a product installer  the installer of the product comms serves
#                        writes or overwrites it on its second pass;
#   operator             nobody: the value after `=` is the default
#                        (an example only where the comment says so),
#                        changed by the operator who needs another.
# A line commented out holds the default too: the value comms takes when
# the variable is absent.
# Not here: what docker-compose.yml sets itself for the comms processes
# (`environment:`) -- a value in .env would be overridden there.
#
# ONE DEPLOY BODY, ENV PROFILES (DD-8): test and prod run the SAME
# compose + CLI; the difference lives entirely in this file (tokens,
# domains, channel mode). Domains are late-bound from env -- never
# baked into code or profile data.
# =============================================================================

# -- Application ------------------------------------------------------------
# "production" on the VPS; log level per taste -- the operator may
# change either.
# by: install
APP_ENV=production
# by: install
LOG_LEVEL=INFO

# -- Postgres (dedicated comms database, DD-3) ------------------------------
# POSTGRES_* feed the comms-postgres container itself; DATABASE_URL is
# what the comms processes dial. Password: generated by `install`
# (openssl rand), written once, never re-minted while the data volume
# exists.
# by: install
POSTGRES_USER=comms
# by: install
POSTGRES_DB=comms
# by: install
POSTGRES_PASSWORD=<generated-by-install>
# by: install
DATABASE_URL=postgresql+asyncpg://comms:<generated-by-install>@comms-postgres:5432/comms

# -- Redis (durable stream backbone, DD-4) ----------------------------------
# Password: generated by `install`. REDIS_URL carries it -- this same
# credentialed URL is handed to the PRODUCT as COMMS_REDIS_URL (the
# relay writes notification_request into the stream), so treat the
# product's .env with the same care as this one.
# by: install
REDIS_PASSWORD=<generated-by-install>
# by: install
REDIS_URL=redis://:<generated-by-install>@comms-redis:6379/0

# -- Service-to-service trust seam (DD-6) -----------------------------------
# THE shared token: single source, generated by `install`, written
# here AND delivered into the product's .env (COMMS_SERVICE_TOKEN).
# The product backend presents it as "Authorization: Bearer <token>"
# on every call to the internal comms API.
# by: install
COMMS_SERVICE_TOKEN=<generated-by-install>

# -- The event contract the PRODUCT writes into (frozen) --------------------
# THE NAMES BELOW ARE HALF OF AN AGREEMENT: the product's outbox relay
# writes notification_request into THIS stream, and comms reads it from
# THIS group. A relay pointing at a different name is not an error
# anywhere -- it writes into a stream nobody reads, and the messages
# simply never arrive. Both sides are defaulted, so a deploy that
# leaves them out works; they are spelled out here because the other
# side of the agreement cannot be expected to read our source to learn
# what to match. Change them only in step with every product writing
# to this deploy.
# by: operator
COMMS_EVENTS_STREAM=comms:events
# by: operator
COMMS_CONSUMER_GROUP=comms

# -- The consumer and its dead letters ---------------------------------------
# The consumer's own name in the group. STABLE on purpose: after a
# restart the same name re-reads its own pending entries. One consumer
# per deploy.
# by: operator
#COMMS_CONSUMER_NAME=comms-1
# Entries one read takes (1..1000) and how long a read waits for new
# ones, in milliseconds (1..60000).
# by: operator
#CONSUMER_BATCH_SIZE=32
# by: operator
#CONSUMER_BLOCK_MS=5000
# The cap of the dead-letter stream <COMMS_EVENTS_STREAM>:dlq, in
# entries (1..10000000), approximate, the oldest trimmed first. No
# expiry besides it. A dead letter holds the entry's address, never its
# letter (deploy/INTEGRATION.md, "How long comms keeps things").
# by: operator
#DLQ_MAXLEN=10000
# The cap of the push stream the product listens on (deploy/INTEGRATION.md
# section 10), in entries (1..10000000), approximate. A product away
# longer than it holds reconciles by the changes feed.
# by: operator
#CHANGES_STREAM_MAXLEN=100000

# -- Channels ---------------------------------------------------------------
# A channel is decided by its own key set, nothing else: every key empty
# = the deploy has no such channel (legal, the service starts); every
# key set = the channel is live; some set, or a malformed value = the
# service REFUSES TO START and names the keys.
# Telegram bot credentials. `install` writes BOTH empty; the real values
# are written by the PRODUCT installer, which owns the bot and already
# holds them -- both of them, never one: a token without the bot URL
# would turn every deep-link button into a permanent delivery failure,
# which is why a half-set refuses startup.
# by: install, then a product installer
TELEGRAM_BOT_TOKEN=
# Deep-link base for buttons, e.g. https://<telegram-host>/<product_bot>.
# by: install, then a product installer
TELEGRAM_BOT_URL=

# -- Email (a channel key set; see deploy/INTEGRATION.md §3a) ----------------
# All three empty = this deploy has no email (legal). All three set =
# the channel is live. Some set, or a malformed value = the service
# REFUSES TO START and names the keys. `install` writes the three
# empty; a product that sends email writes them on its second pass.
# by: install, then a product installer
EMAIL_MAILGUN_API_KEY=
# by: install, then a product installer
EMAIL_MAILGUN_DOMAIN=
# A bare address, or the display form "Name <address>".
# by: install, then a product installer
EMAIL_FROM_ADDRESS=
# Provider region: eu or us. Has a DEFAULT (eu), so it does not take
# part in deciding whether the channel exists -- but a value outside
# the set refuses startup.
# by: a product installer
#EMAIL_MAILGUN_REGION=eu

# -- LLM channel (deploy/INTEGRATION.md section 11) ---------------------------
# Named key sets, one JSON object: {"llm.text": {"endpoint": "https://...",
# "key": "...", "model": "...", "gateway": true}}. Empty = no llm.
# by: install
LLM_KEY_SETS=
# Seconds one call to ONE key set may take (above the llm client's 114).
# by: operator
#LLM_DELIVER_TIMEOUT_SECONDS=120
# The exact host:port pairs a letter's audio link may point at, comma
# separated (e.g. rustfs:9000). Empty = no body is ever fetched.
# by: operator
LLM_BODY_HOSTS=

# -- Localization -----------------------------------------------------------
# The template-rendering fallback language: recipient locale -> this ->
# the stored title/body.
# by: install
DEFAULT_LOCALE=en
# Fallback IANA timezone for recipients without one (quiet-hours window
# math). Validated at startup.
# by: install
DEFAULT_TIMEZONE=UTC

# -- Notification engine -----------------------------------------------------
# Seconds an idle worker waits between polls (1..3600), and its longest
# sleep (1..3600, not below the poll interval).
# by: operator
#NOTIFICATION_POLL_INTERVAL_SECONDS=5
# by: operator
#NOTIFICATION_MAX_BACKOFF_SECONDS=60
# Attempts of one delivery (1..100) before it fails.
# by: operator
#NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
# Attempts of the PIPELINE that may end in an exception of comms' own
# (1..100) before the job gets its outcome (failed, class `pipeline`).
# by: operator
#NOTIFICATION_MAX_PIPELINE_ATTEMPTS=3

# -- Lanes (deploy/INTEGRATION.md section 3, `lane`) -------------------------
# The lanes THIS worker process takes, comma-separated, from
# interactive, critical, normal, bulk. Unset (the default): all four.
# Written but empty, an unknown lane or a repeated one refuses startup.
# The worker processes of a deploy together must take every lane. The
# value below is an example, not the default.
# by: operator
#COMMS_WORKER_LANES=interactive,critical,normal,bulk
# Jobs one pass of each lane selects (1..1000), the tail picked up on
# its next pass. 0 does not switch a lane off -- leaving it out of
# COMMS_WORKER_LANES does.
# by: operator
#NOTIFICATION_LANE_INTERACTIVE_BATCH_SIZE=10
# by: operator
#NOTIFICATION_LANE_CRITICAL_BATCH_SIZE=10
# by: operator
#NOTIFICATION_LANE_NORMAL_BATCH_SIZE=50
# by: operator
#NOTIFICATION_LANE_BULK_BATCH_SIZE=20
# Seconds one channel call of each lane may take before it is abandoned
# as a timeout (1..600). Each must be ABOVE the client timeout of every
# live channel (29 s for telegram and email), or startup is refused.
# by: operator
#NOTIFICATION_LANE_INTERACTIVE_DELIVER_TIMEOUT_SECONDS=30
# by: operator
#NOTIFICATION_LANE_CRITICAL_DELIVER_TIMEOUT_SECONDS=30
# by: operator
#NOTIFICATION_LANE_NORMAL_DELIVER_TIMEOUT_SECONDS=30
# by: operator
#NOTIFICATION_LANE_BULK_DELIVER_TIMEOUT_SECONDS=30

# -- Retries and rate limits -------------------------------------------------
# Per-delivery transient-retry backoff: base * 2**(attempts-1), capped
# (seconds, 0..86400 each; the cap not below the base).
# by: operator
#NOTIFICATION_RETRY_BACKOFF_BASE_SECONDS=30
# by: operator
#NOTIFICATION_RETRY_BACKOFF_MAX_SECONDS=600
# Trust limit on the channel-named 429 wait (seconds, 1..86400).
# Generous by design: capping must stay exceptional (capped=true in the
# deferral log is an alarm, not noise).
# by: operator
#NOTIFICATION_MAX_RETRY_AFTER_SECONDS=3600
# 429 deferral budget per delivery (0..1000): a channel rate limit
# defers by the server-named wait WITHOUT burning an attempt, up to
# this many times; past it a 429 is a regular transient failure.
# by: operator
#NOTIFICATION_MAX_RATE_LIMIT_DEFERRALS=10

# -- Housekeeping (deploy/INTEGRATION.md, "How long comms keeps things") ----
# Days a notification in a terminal state is kept (0..3650); 0 DISABLES
# retention -- never "delete everything".
# by: operator
#NOTIFICATION_RETENTION_DAYS=90
# Seconds between retention passes (1..86400). 0 is refused, not
# "every tick": off is NOTIFICATION_RETENTION_DAYS=0.
# by: operator
#NOTIFICATION_RETENTION_INTERVAL_SECONDS=3600
# Days of silence after which a thread is closed (0..3650); 0 DISABLES
# auto-close. Closing is a status change, nothing is deleted.
# by: operator
#THREAD_AUTO_CLOSE_DAYS=30
# Seconds between auto-close passes (1..86400). 0 is refused; off is
# THREAD_AUTO_CLOSE_DAYS=0.
# by: operator
#THREAD_AUTO_CLOSE_INTERVAL_SECONDS=3600

# -- Profile (per-product artifact, arch #15) -------------------------------
# HOST path of the profile directory (types.yaml + templates/),
# bind-mounted read-only into the comms processes. Always OUTSIDE this
# checkout, so `update` never touches it.
#
# Who sets it:
#   - standalone (this CLI on its own): the default below, seeded with
#     the generic smoke profile because the directory is empty;
#   - with a product: the product's installer points this at the
#     profile inside ITS OWN repo, so that editing a template is a
#     commit in the product and a roll-out -- no copy on this side to
#     keep in step, and nothing for anyone to place by hand. A
#     populated directory is never overwritten.
# by: install, then a product installer
PROFILE_DIR=/opt/comms/profile

# HOST path of the TEXT OVERLAY (optional): {locale}.yaml files of the
# shape of templates/{locale}.yaml, directly in the directory, each text
# replacing the profile's text at the same locale, type, channel and
# field (deploy/INTEGRATION.md section 3). Set by the product's
# installer on the same seam as PROFILE_DIR. Empty = no overlay, the
# profile's texts as they are. Set to a path that is not an existing
# directory = nothing starts; an existing empty directory = zero
# overrides, said in the startup log.
# by: install, then a product installer
PROFILE_OVERLAY_DIR=

# -- Token hand-over (DD-6, install-time only) ------------------------------
# ABSOLUTE path of the PRODUCT backend's .env on this VPS -- the
# target where `install` writes the three COMMS_* variables. This is
# per-product CONFIG (DD-8): the deploy body carries no product path.
#
# Empty is the value on a FRESH file, and it stays empty for exactly as
# long as it takes the product installer to write it -- that is the
# documented two-pass flow (see INTEGRATION.md), not a task waiting for
# a human. `install` printing the block instead of writing it is the
# standalone fallback, for a run with no product installer driving it.
# by: install, then a product installer
PRODUCT_ENV_PATH=
