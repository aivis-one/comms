# =============================================================================
# COMMS deploy -- environment REFERENCE (.env.example)
# =============================================================================
#
# Every variable a comms process can read: what it does, who gives it,
# and what a sane value looks like. No file is generated from this one: on
# a box, Primer's deploy machine renders the instance's values by
# primer.yaml `env`, and deploy/docker-compose.yml hands them to the
# processes (W1-2). tests/test_env_template.py holds it to the code both
# ways -- every setting of app/core/config.py is here, every variable here
# is a setting or a variable the compose file reads -- and to the compose
# file and primer.yaml.
#
# WHO GIVES IT -- the `# by:` line right above each variable:
#   primer.yaml  a key of primer.yaml `env`: the machine renders it (the
#                passport, a minted secret, a derived value) and the
#                compose file passes it as `${KEY:?}`; the value after
#                `=` is a placeholder;
#   compose      the compose file sets it, written here as compose
#                writes it (DATABASE_URL, REDIS_URL from the keys above
#                them);
#   default      nothing on a box sets it: the value after `=` is the
#                code's default (an example only where the comment says
#                so) -- a default is the product's constant (contract 3).
# A line commented out holds the default too: the value comms takes when
# the variable is absent.
# =============================================================================

# -- Application ------------------------------------------------------------
# by: default
#APP_ENV=production
# by: default
#LOG_LEVEL=INFO

# -- Postgres (dedicated comms database, DD-3) ------------------------------
# The password is minted by the machine once and kept; the user and the
# database are the compose file's constants (comms, comms).
# by: primer.yaml
POSTGRES_PASSWORD=<minted-by-the-machine>
# by: compose
DATABASE_URL=postgresql+asyncpg://comms:${POSTGRES_PASSWORD:?}@comms-postgres:5432/comms

# -- Redis (durable stream backbone, DD-4) ----------------------------------
# The password is minted by the machine and given to the PRODUCT as the
# seam COMMS_EVENTS_PASSWORD (deploy/INTEGRATION.md section 15): the
# product writes notification_request into the stream with it. Only the
# consumer reads REDIS_URL.
# by: primer.yaml
COMMS_EVENTS_PASSWORD=<minted-by-the-machine>
# by: compose
REDIS_URL=redis://:${COMMS_EVENTS_PASSWORD:?}@comms-redis:6379/0

# -- Service-to-service trust seam (DD-6) -----------------------------------
# THE shared token: single source, minted by the machine and given to
# the product as the seam COMMS_SERVICE_TOKEN. The product backend
# presents it as "Authorization: Bearer <token>" on every call to the
# internal comms API.
# by: primer.yaml
COMMS_SERVICE_TOKEN=<minted-by-the-machine>
# The NEXT token, only while the key is being changed: a request passes
# with either token (deploy/INTEGRATION.md, "Changing the service token
# without downtime"). Empty = only COMMS_SERVICE_TOKEN passes. Never set
# without COMMS_SERVICE_TOKEN: comms refuses to start. primer.yaml
# declares no key for it yet, so on a box it is empty.
# by: default
COMMS_SERVICE_TOKEN_NEXT=

# -- The event contract the PRODUCT writes into (frozen) --------------------
# THE NAMES BELOW ARE HALF OF AN AGREEMENT: the product's outbox relay
# writes notification_request into THIS stream, and comms reads it from
# THIS group. A relay pointing at a different name is not an error
# anywhere -- it writes into a stream nobody reads, and the messages
# simply never arrive. Both sides are defaulted, so a deploy that
# leaves them out works; they are spelled out here because the other
# side of the agreement cannot be expected to read our source to learn
# what to match. Change them only in step with every product writing
# to this deploy.
# by: default
COMMS_EVENTS_STREAM=comms:events
# by: default
COMMS_CONSUMER_GROUP=comms

# -- The consumer ------------------------------------------------------------
# The consumer's own name in the group. STABLE on purpose: after a
# restart the same name re-reads its own pending entries. One consumer
# per deploy.
# by: default
#COMMS_CONSUMER_NAME=comms-1
# Entries one read takes (1..1000) and how long a read waits for new
# ones, in milliseconds (1..60000).
# by: default
#CONSUMER_BATCH_SIZE=32
# by: default
#CONSUMER_BLOCK_MS=5000
# The cap of the push stream the product listens on (deploy/INTEGRATION.md
# section 10), in entries (1..10000000), approximate. A product away
# longer than it holds reconciles by the changes feed.
# by: default
#CHANGES_STREAM_MAXLEN=100000

# -- Channels ---------------------------------------------------------------
# A channel is decided by its flag, nothing else (deploy/INTEGRATION.md
# §3a). <CHANNEL>_ENABLED is exactly true or false, with no default: an
# absent flag, or any other value, and the service REFUSES TO START,
# naming it. false = the deploy has no such channel (legal, the service
# starts); its keys below are not read, whatever they hold. true = every
# key of the channel is required: a key missing, or a malformed value,
# and the service REFUSES TO START and names the keys. in_app has no
# flag: it is always on. On a box the flag is the passport's option of
# the channel; a key of an option that is off holds the machine's
# literal, which comms never reads.
# by: primer.yaml
TELEGRAM_ENABLED=false
# by: primer.yaml
EMAIL_ENABLED=false
# by: primer.yaml
LLM_ENABLED=false

# Telegram bot credentials: the token is given by the passport, the bot
# URL derived from it (`comms derive bot-url`) -- both of them, never
# one: a token without the bot URL would turn every deep-link button
# into a permanent delivery failure, which is why a half-set refuses
# startup while TELEGRAM_ENABLED=true.
# by: primer.yaml
TELEGRAM_BOT_TOKEN=
# Deep-link base for buttons, e.g. https://<telegram-host>/<product_bot>.
# by: primer.yaml
TELEGRAM_BOT_URL=

# -- Email (the channel's keys; see deploy/INTEGRATION.md §3a) ---------------
# Read only with EMAIL_ENABLED=true: then all three are required, and a
# key missing, or a malformed value, refuses startup naming the keys.
# The passport gives them under the option `email`.
# by: primer.yaml
EMAIL_MAILGUN_API_KEY=
# by: primer.yaml
EMAIL_MAILGUN_DOMAIN=
# A bare address -- noreply@example.com -- or the display form
# Name <address>: "Comms <noreply@example.com>".
# by: primer.yaml
EMAIL_FROM_ADDRESS=
# Provider region: eu or us. Has a DEFAULT (eu) in the code, yet is a key
# of primer.yaml `env`: the region is a fact of the instance's provider
# account. With email on, a value outside the set refuses startup.
# by: primer.yaml
EMAIL_MAILGUN_REGION=eu

# -- LLM channel (deploy/INTEGRATION.md section 11) ---------------------------
# Named key sets, one JSON object: {"llm.text": {"endpoint": "https://...",
# "key": "...", "model": "...", "gateway": true}}. Read only with
# LLM_ENABLED=true, and then required.
# by: primer.yaml
LLM_KEY_SETS=
# Seconds one call to ONE key set may take (above the llm client's 114).
# by: default
#LLM_DELIVER_TIMEOUT_SECONDS=120
# The point of the product's object store, <host>:<port>, no scheme -- a
# seam the machine gives from the product. A letter's audio link is
# fetched only from http://<it>/...; empty = no product storage, every
# such link is refused. A value not of that form refuses the start, the
# llm channel on or off.
# by: primer.yaml
PRODUCT_STORAGE_ADDRESS=

# -- Localization -----------------------------------------------------------
# The template-rendering fallback language: recipient locale -> this ->
# the stored title/body.
# by: default
DEFAULT_LOCALE=en
# Fallback IANA timezone for recipients without one (quiet-hours window
# math). Validated at startup.
# by: default
DEFAULT_TIMEZONE=UTC

# -- Notification engine -----------------------------------------------------
# Seconds an idle worker waits between polls (1..3600), and its longest
# sleep (1..3600, not below the poll interval).
# by: default
#NOTIFICATION_POLL_INTERVAL_SECONDS=5
# by: default
#NOTIFICATION_MAX_BACKOFF_SECONDS=60
# Attempts of one delivery (1..100) before it fails.
# by: default
#NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
# Attempts of the PIPELINE that may end in an exception of comms' own
# IN A ROW (1..100) before the job gets its outcome (failed, class
# `pipeline`); an attempt that succeeds starts the count again.
# by: default
#NOTIFICATION_MAX_PIPELINE_ATTEMPTS=3

# -- Lanes (deploy/INTEGRATION.md section 3, `lane`) -------------------------
# The lanes THIS worker process takes, comma-separated, from
# interactive, critical, normal, bulk. Unset (the default): all four.
# Written but empty, an unknown lane or a repeated one refuses startup.
# The worker processes of a deploy together must take every lane. The
# value below is an example, not the default.
# by: default
#COMMS_WORKER_LANES=interactive,critical,normal,bulk
# Jobs one pass of each lane selects (1..1000), the tail picked up on
# its next pass. 0 does not switch a lane off -- leaving it out of
# COMMS_WORKER_LANES does.
# by: default
#NOTIFICATION_LANE_INTERACTIVE_BATCH_SIZE=10
# by: default
#NOTIFICATION_LANE_CRITICAL_BATCH_SIZE=10
# by: default
#NOTIFICATION_LANE_NORMAL_BATCH_SIZE=50
# by: default
#NOTIFICATION_LANE_BULK_BATCH_SIZE=20
# Seconds one channel call of each lane may take before it is abandoned
# as a timeout (1..600). Each must be ABOVE the client timeout of every
# live channel (29 s for telegram and email), or startup is refused.
# by: default
#NOTIFICATION_LANE_INTERACTIVE_DELIVER_TIMEOUT_SECONDS=30
# by: default
#NOTIFICATION_LANE_CRITICAL_DELIVER_TIMEOUT_SECONDS=30
# by: default
#NOTIFICATION_LANE_NORMAL_DELIVER_TIMEOUT_SECONDS=30
# by: default
#NOTIFICATION_LANE_BULK_DELIVER_TIMEOUT_SECONDS=30

# -- Retries and rate limits -------------------------------------------------
# Per-delivery transient-retry backoff: base * 2**(attempts-1), capped
# (seconds, 0..86400 each; the cap not below the base).
# by: default
#NOTIFICATION_RETRY_BACKOFF_BASE_SECONDS=30
# by: default
#NOTIFICATION_RETRY_BACKOFF_MAX_SECONDS=600
# Trust limit on the channel-named 429 wait (seconds, 1..86400).
# Generous by design: capping must stay exceptional (capped=true in the
# deferral log is an alarm, not noise).
# by: default
#NOTIFICATION_MAX_RETRY_AFTER_SECONDS=3600
# 429 deferral budget per delivery (0..1000): a channel rate limit
# defers by the server-named wait WITHOUT burning an attempt, up to
# this many times; past it a 429 is a regular transient failure.
# by: default
#NOTIFICATION_MAX_RATE_LIMIT_DEFERRALS=10

# -- Housekeeping (deploy/INTEGRATION.md, "How long comms keeps things") ----
# Days a notification in a terminal state is kept (0..3650); 0 DISABLES
# retention -- never "delete everything".
# by: default
#NOTIFICATION_RETENTION_DAYS=90
# Seconds between retention passes (1..86400). 0 is refused, not
# "every tick": off is NOTIFICATION_RETENTION_DAYS=0.
# by: default
#NOTIFICATION_RETENTION_INTERVAL_SECONDS=3600
# Days of silence after which a thread is closed (0..3650); 0 DISABLES
# auto-close. Closing is a status change, nothing is deleted.
# by: default
#THREAD_AUTO_CLOSE_DAYS=30
# Seconds between auto-close passes (1..86400). 0 is refused; off is
# THREAD_AUTO_CLOSE_DAYS=0.
# by: default
#THREAD_AUTO_CLOSE_INTERVAL_SECONDS=3600

# -- Profile (per-product artifact, arch #15) -------------------------------
# The profile directory (types.yaml + templates/) inside the container,
# mounted read-only -- temporarily from the host path /srv/comms/profile,
# until W4-1 (deploy/docker-compose.yml, KNOWN CEILING in
# scripts/check_primer_yaml.py).
# by: compose
TEMPLATES_DIR=/profile

# The TEXT OVERLAY directory inside the container (optional):
# {locale}.yaml files of the shape of templates/{locale}.yaml, each text
# replacing the profile's text at the same locale, type, channel and
# field (deploy/INTEGRATION.md section 3). Empty = no overlay, the
# profile's texts as they are. It has no mount on a box until W4-1, so
# it stays empty there.
# by: default
TEMPLATES_OVERLAY_DIR=
