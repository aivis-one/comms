# =============================================================================
# COMMS deploy -- environment REFERENCE (.env.example)
# =============================================================================
#
# The real ./.env is GENERATED by `comms-deploy.sh install` next to
# docker-compose.yml and is never committed. This file documents every
# variable: what it does, who writes it (the installer vs the
# operator), and what a sane value looks like.
#
# ONE DEPLOY BODY, ENV PROFILES (DD-8): test and prod run the SAME
# compose + CLI; the difference lives entirely in this file (tokens,
# domains, channel mode). Domains are late-bound from env -- never
# baked into code or profile data.
# =============================================================================

# -- Application ------------------------------------------------------------
# Operator-owned. "production" on the VPS; log level per taste.
APP_ENV=production
LOG_LEVEL=INFO

# -- Postgres (dedicated comms database, DD-3) ------------------------------
# POSTGRES_* feed the comms-postgres container itself; DATABASE_URL is
# what the comms processes dial. Password: generated by `install`
# (openssl rand), written once, never re-minted while the data volume
# exists.
POSTGRES_USER=comms
POSTGRES_DB=comms
POSTGRES_PASSWORD=<generated-by-install>
DATABASE_URL=postgresql+asyncpg://comms:<generated-by-install>@comms-postgres:5432/comms

# -- Redis (durable stream backbone, DD-4) ----------------------------------
# Password: generated by `install`. REDIS_URL carries it -- this same
# credentialed URL is handed to the PRODUCT as COMMS_REDIS_URL (the
# relay writes notification_request into the stream), so treat the
# product's .env with the same care as this one.
REDIS_PASSWORD=<generated-by-install>
REDIS_URL=redis://:<generated-by-install>@comms-redis:6379/0

# -- Service-to-service trust seam (DD-6) -----------------------------------
# THE shared token: single source, generated by `install`, written
# here AND delivered into the product's .env (COMMS_SERVICE_TOKEN).
# The product backend presents it as "Authorization: Bearer <token>"
# on every call to the internal comms API.
COMMS_SERVICE_TOKEN=<generated-by-install>

# -- Channels ---------------------------------------------------------------
# "stub" until the real bot token is in place; flip to "real" to send.
CHANNELS_MODE=stub
# Telegram bot credentials -- operator replaces the generated
# placeholder with the real bot token before CHANNELS_MODE=real.
TELEGRAM_BOT_TOKEN=<generated-placeholder-replace-with-real-bot-token>
# Deep-link base for buttons, e.g. https://t.me/<product_bot>.
TELEGRAM_BOT_URL=
# Telegram Bot API base override (self-hosted bot-api / test server).
# Empty = official API. Reserved knob: consumed when channels go real.
TELEGRAM_API_BASE=

# -- Localization -----------------------------------------------------------
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC

# -- Profile (per-product artifact, arch #15) -------------------------------
# HOST path of the profile directory (types.yaml + templates/),
# bind-mounted read-only into the comms processes. Lives OUTSIDE the
# checkout so `update` never touches it. `install` seeds it with the
# generic smoke profile ONLY if empty; the real product profile is
# dropped in on top by the operator.
PROFILE_DIR=/opt/comms/profile

# -- Token hand-over (DD-6, install-time only) ------------------------------
# Where `install` looks for the PRODUCT's .env to write the three
# COMMS_* variables into (confirmed velo layout). If the file is
# absent, install prints the block for manual paste instead.
# fence: product-seam
VELO_ENV_PATH=/opt/velo/repo/backend/.env
