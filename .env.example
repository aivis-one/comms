# =============================================================================
# COMMS Service -- Environment Template
# =============================================================================
# Copy to .env and fill in. One comms deploy per product; the database
# is a DEDICATED database + role inside that product's Postgres.
# =============================================================================

# -- Application --
# "development" enables local defaults; anything else requires
# DATABASE_URL to be set explicitly.
APP_ENV=development
LOG_LEVEL=INFO

# -- Database (dedicated comms database in the product Postgres) --
DATABASE_URL=postgresql+asyncpg://comms:comms@localhost:5432/comms

# -- Channels --
# stub = nothing leaves the process (tests/CI); real = configured
# channels send (Phase 1: telegram only).
CHANNELS_MODE=stub

# -- Telegram (bot shared with the product) --
TELEGRAM_BOT_TOKEN=
# Base URL for deep-link buttons, e.g. https://t.me/velo_testbot
TELEGRAM_BOT_URL=

# -- Localization --
DEFAULT_LOCALE=en

# -- Notification engine --
NOTIFICATION_POLL_INTERVAL_SECONDS=5
NOTIFICATION_MAX_BACKOFF_SECONDS=60
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
